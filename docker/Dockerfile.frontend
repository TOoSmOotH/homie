FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package manifests first to leverage Docker layer caching
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY frontend/package*.json ./frontend/

# Install all workspace dependencies (including devDeps for build)
RUN npm ci --include=dev

# Copy the rest of the source
COPY shared/ ./shared/
COPY frontend/ ./frontend/

# Build shared types and frontend from workspace context
RUN npm run build --workspace=@homie/shared
RUN npm run build --workspace=@homie/frontend

# Expose port
EXPOSE 3000

# Start the application (Vite preview)
CMD ["npm", "run", "preview", "--workspace=@homie/frontend", "--", "--host", "0.0.0.0", "--port", "3000"]
