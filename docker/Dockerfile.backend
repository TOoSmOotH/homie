FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY backend/package*.json ./backend/

# Install root dependencies (ensure devDependencies are included)
RUN npm ci --include=dev

# Install backend and shared dependencies explicitly
COPY shared/ ./shared/
RUN cd shared && npm ci --include=dev && cd ..

COPY backend/ ./backend/
RUN cd backend && npm ci --include=dev && cd ..

# Build shared types
RUN npm run build --workspace=@homie/shared

# Build backend from project root to maintain workspace context
RUN npm run build --workspace=@homie/backend

# Create data directory
RUN mkdir -p /app/data /app/logs

# Expose port
EXPOSE 9827

# Start the application
CMD ["node", "backend/dist/server.js"]
